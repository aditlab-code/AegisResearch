@CONFERENCE{Anas2026,
	author = {Anas, Bouabid and Hafid, Barka and Nawfal, Acha},
	title = {A Survey on the State of Explainable Artificial Intelligence in Financial Fraud Detection: Frameworks, Modalities, and Regulatory Compliance in the 2026 Landscape},
	year = {2026},
	journal = {2026 International Conference on Intelligent Systems and Digital Applications, ISDA 2026 - Proceedings},
