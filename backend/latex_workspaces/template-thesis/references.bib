@CONFERENCE{Vignesh2026,
	author = {Vignesh, S.R. and Praveen Kumar, S.},
	title = {Transformer-Based Detection of Online Fake Job Advertisements Using DistilBERT with LLM-Powered Explainability},
	year = {2026},
	journal = {4th International Conference on Integrated Circuits and Communication Systems, ICICACS 2026},
	pages = {},
	doi = {10.1109/ICICACS68679.2026.11578934},
	url = {https://www.scopus.com/pages/publications/105044432383?origin=resultslist},
	affiliations = {SRM Institute of Science and Technology, Department of Computational Intelligence, Tamil Nadu, Kattankulathur, 603203, India; SRM Institute of Science and Technology, Department of Data Science and Business Systems, Tamil Nadu, Kattankulathur, 603203, India},
	abstract = {Fraudulent job postings on digital recruitment platforms pose growing risks to job seekers by harvesting personal data, soliciting illegal upfront fees, and channelling victims into financial scams. Conventional keyword-filter defences fail against semantically sophisticated deception, motivating the adoption of contextual deep learning models. This paper presents a fully automated end-to-end detection pipeline for fake job advertisements, built around a fine-tuned DistilBERT transformer classifier augmented with a large language model (LLM) explanation layer. The system is trained on the EMSCAD benchmark corpus, which contains 17,880 labelled postings and exhibits a severe 20:1 genuine-to-fraudulent class skew. A three-operation lexical augmentation scheme - synonym substitution, token dropout, and position swapping - expands minority-class training instances from 582 to 7,732, while a class-weighted cross-entropy objective prevents the majority class from dominating gradient updates. The fine-tuned model attains 98.31% accuracy, a ROC-AUC of 96.72%, fraud-class recall of 71.2%, and a Matthews Correlation Coefficient of 0.801 on a withheld evaluation partition. An ablation study confirms that augmentation and loss weighting each independently improve fraud-class recall. Structured natural-language justifications identifying specific deception indicators are generated by Llama-3.3-70B-Versatile through the Groq inference API, bridging the gap between a binary classifier verdict and actionable user guidance. The complete pipeline is deployed as a dual-mode Streamlit web application supporting both direct text entry and live URL scraping. © 2026 IEEE.},
	author_keywords = {class imbalance; DistilBERT; EMSCAD; explainable AI; Fake job detection; Groq; Llama; Streamlit; text augmentation; text classification; transformer models},
	keywords = {Benchmarking; Classification (of information); Computational linguistics; Data mining; Deep learning; Employment; Fake detection; Learning systems; Natural language processing systems; Semantics; Text processing; Class imbalance; Distilbert; EMSCAD; Explainable AI; Fake job detection; Groq; Llama; Streamlit; Text augmentation; Text classification; Transformer modeling; Crime},
