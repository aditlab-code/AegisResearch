@CONFERENCE{Shah2026,
	author = {Shah, Heth M and Achyuth, H. and Sarasvathi, V. and Vinodha, K.},
	title = {Detection and Mitigation of Data Poisoning in Financial LLMs Using a Hybrid Static-Dynamic Framework},
	year = {2026},
	journal = {2026 IEEE Guwahati Subsection Conference, GCON 2026},
	pages = {},
	doi = {10.1109/GCON69192.2026.11648426},
	url = {https://www.scopus.com/pages/publications/105049049841?origin=resultslist},
	affiliations = {PES University, Department of Computer Science and Engineering, Bengaluru, India; RV University, School of Computer Science and Engineering, Bengaluru, India},
	abstract = {The financial sector has begun to utilize Artificial Intelligence (AI) and Language Models(LMs) to perform sentiment analysis, previously preventing fraud detection and making decisions. However, these systems can easily be subjected to data poisoning which is the result of introducing toxic data into the training program that interferes with the resulting prediction accuracy. In order to protect financial language models from these types of attacks, a Hybrid Static-Dynamic Detection and Mitigation Framework has been developed and presented in this paper. The Hybrid Static-Dynamic Detection and Mitigation Framework consists of two parts: the static layer and the dynamic layer. The static layer of the Framework employs token frequency analysis, semantic outlier detection using FinBERT embeddings, Principal Component Analysis (PCA), and Isolation Forests for detecting suspicious data. The dynamic layer of the Framework monitors the output of the models in real time and compares the output against the validation tests performed under the explanation coherence characteristics of Local Interpretable Model-agnostic Explanations(LIME) and SHapley Additive exPlanations(SHAP) as well as monitoring consistency with market conditions at the time. The output of both layers is combined in a two-tier fusion process to create a heuristic score that is then utilized as input into an XGBoost classifier. Overall, the Static-Dynamic Detection and Mitigation Framework improves on the ability to accurately detect attacks on financial language models while still providing Explainable AI to provide the user with an explanation of the reasoning behind the models' decision. Additionally, experimental results show how the Static-Dynamic Detection and Mitigation Framework enhances the robustness and reliability of AI financial systems against potential threats originating from data poisoning attempts. © 2026 IEEE.},
