	url = {https://www.scopus.com/pages/publications/105019065189?origin=resultslist},
	affiliations = {LaMSD, Team of MSASE, Department of Economics, FSJES, Mohammed First University, Oujda, Morocco; Research Laboratory on Modeling Applied to Economics and Management, FSJES Aïn Sebaâ, Hassan II University in Casablanca, Casablanca, Morocco; LERJP, FSJES Souissi, Mohammed V University in Rabat, BP, Rabat, Morocco},
	abstract = {Credit card fraud in industrial goods purchasing has become so sophisticated that detection mechanisms must also be highly advanced. This research provides an incomparably successful implementation of explainable AI, improving efficiency and understanding in credit card fraud detection. We carefully analyze transactional data and solve the class imbalance problem using SMOTE and ADASYN, which have shown promise for models. Our innovation combines ML models with optimization algorithms to develop new models capable of analyzing large-scale credit card transaction data, including fraud-related patterns. Models are refined via hyperparameter optimization and evaluated using ACC, F1-score, and AUC. While retaining interpretability, the new models incorporate Deep Learning for better detection of complex fraud patterns. Among the tested approaches, the best-performing model-XGBoost+DT-SHAP with the Gini criterion under ADASYN-achieved high precision ((Formula presented.) %), the strongest F1-score ((Formula presented.) %), and recall ((Formula presented.) %), offering the most balanced performance for large-scale credit card fraud detection. This work highlights the critical role of XAI in enhancing accuracy and transparency. Our improved hybrid models can detect fraudulent activity in real time, significantly reducing losses from credit card fraud in online industrial goods transactions. © 2025 Informa UK Limited, trading as Taylor & Francis Group.},
