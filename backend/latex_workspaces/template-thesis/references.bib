	title = {Explainable AI Models for Automated Decision-Making in Financial Fraud Detection Systems},
	year = {2026},
	journal = {2026 IEEE 2nd International Conference on Quantum Photonics, Artificial Intelligence and Networking, QPAIN 2026},
	pages = {},
	doi = {10.1109/QPAIN69676.2026.11546354},
