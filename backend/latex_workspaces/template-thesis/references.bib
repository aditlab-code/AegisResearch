@ARTICLE{Sourav2026,
	author = {Sourav, Md Sultanul Arefin and Rozario, Evha and Islam, Md Ashiqul and Chy, Kaniz Sultana and Akter, Samia and Shahiduzzaman, Md and Hossain, Mohammad Sazzad and Kabtia, Maria and Chakraborty, Partha and Basit, Abdul},
	title = {Grounding language models with deterministic verifiers for fraud detection},
	year = {2026},
	journal = {Discover Artificial Intelligence},
	volume = {6},
	number = {1},
	pages = {},
	doi = {10.1007/s44163-026-02355-0},
	url = {https://www.scopus.com/pages/publications/105053035489?origin=resultslist},
	affiliations = {Department of Business Analytics, Trine University, Angola, IN, United States; International American University, Los Angeles, CA, United States; Department of Business Analytics, Trine University, Tempe, AZ, United States; College of Graduate and Professional Studies, Trine University, Angola, 46703, IN, United States; Riceland Healthcare, Beaumont, 77707, TX, United States; Department of Information Systems, Lamar University, Beaumont, 77710, TX, United States; University of the Cumberlands, Williamsburg, 40769, KY, United States; Department of Computer Science and Engineering, Mekelle University, Mekelle, Ethiopia},
	abstract = {Financial fraud detection is complicated by severe class imbalance, temporal change, adversarial manipulation, and the need for evidence-grounded explanations. Although large language models can generate readable rationales, their claims may be unsupported when they are not independently checked against structured evidence. We propose VR-FraudNet, a five-stage framework combining a time-conditioned spectral graph encoder, LightGBM triage and threshold routing, a schema-constrained rationale language model, a fixed deterministic verifier, and an isotonic probability mixer with split-conformal calibration. The language model proposes machine-checkable claims for review-band transactions, while the verifier evaluates each claim against the available transaction, temporal, and graph evidence. Verifier-rejected rationales are excluded from automated use, and the corresponding transactions are assigned to human-review escalation. D1 BAF, D2 AMLworld HI-Small, and D3 IEEE-CIS are used as the primary predictive benchmarks, whereas D4 Elliptic++ and D5 DGraph-Fin support complementary temporal-graph, strict-inductive, temporal-robustness, and message-passing stress tests. VR-FraudNet improves AUPRC over TabTransformer from 0.5012 to 0.5247 on D1, from 0.5137 to 0.5824 on D2, and from 0.7234 to 0.7456 on D3. The predeclared 5-percentage-point temporal-degradation target is satisfied in the evaluated D1 month-drift, D3 late-fold, and D4 pre-shock comparisons. However, D4 post-shock AUPRC decreases from 0.6823 to 0.6087, an absolute reduction of 7.36 percentage points that exceeds the target. Under the four-family structured predictive edit set, mean evasion rates are 0.0667, 0.1016, and 0.1672 for budgets 1, 2, and 4, respectively. Under the stated operational cost assumptions, VR-FraudNet produces lower total loss than TabTransformer, with the largest difference on D2. Measured p99 latency is 10.23 ms on the common path and 175.23 ms on the escalation path under the reported hardware configuration. Empirical split-conformal miscoverage remains below the stated bounds in the reported calibration settings, while the formal marginal-coverage statement applies only under the stated exchangeability assumptions. These findings support verifier-grounded fraud detection under the evaluated public datasets and protocols but do not establish universal adversarial safety, temporal robustness, regulatory sufficiency, or deployment readiness. © The Author(s) 2026.},
	author_keywords = {Adversarial robustness; Deterministic verifier; Explainable AI; Financial fraud detection; Graph neural networks; Probability calibration; Rationale verification; Temporal drift; Transaction classification; Verifier-grounded language models},
	keywords = {Artificial intelligence; Automation; Barium compounds; Benchmarking; Calibration; Crime; Error detection; Finance; Adversarial robustness; Deterministic verifier; Deterministics; Explainable AI; Financial fraud detections; Graph neural networks; Language model; Probability calibration; Rationale verification; Temporal drifts; Transaction classification; Verifier-grounded language model; Budget control},
