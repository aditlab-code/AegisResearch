@CONFERENCE{Dida2025144,
	author = {Dida, Jarso Dulacha and Akbar, Izzat Aulia},
	title = {A Dynamic RBAC Framework for Real-Time Detection and Prevention of Unauthorized Access in Text-Based Generative-AI Systems},
	year = {2025},
	journal = {Proceeding of the International Conference on Computer Engineering, Network and Intelligent Multimedia 2025, CENIM 2025},
	pages = {144 - 151},
	doi = {10.1109/CENIM67940.2025.11325812},
	url = {https://www.scopus.com/pages/publications/105033157771?origin=resultslist},
	affiliations = {Dept. of Information Systems, Institut Teknologi Sepuluh Nopember, Surabaya, Indonesia},
	abstract = {—Text-based Generative AI systems are increasingly used in domains such as healthcare, finance, and cybersecurity to automate tasks, enhance decision-making, and support AI-assisted diagnostics, fraud analysis, and secure information processing. Despite these benefits, they remain vulnerable to unauthorized access that can expose sensitive data and erode trust. Conventional Role-Based Access Control (RBAC) mechanisms are inherently static, limiting their ability to respond to evolving behaviors and contextual threats. This study introduces a dynamic, behavior-aware RBAC framework that integrates real-time anomaly detection using the Isolation Forest algorithm. The architecture continuously monitors user activity and adjusts privileges based on behavioral trust rather than fixed roles. A functional prototype validated on synthetic and real-world datasets (LANL, CERT) achieved consistently high accuracy with minimal latency and false positives. The approach bridges the gap between rigid access control and the need for adaptive, explainable, and governance-aligned security in real-time Generative AI environments. ©2025 IEEE.},
