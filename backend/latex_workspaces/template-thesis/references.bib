	url = {https://www.scopus.com/pages/publications/105047564267?origin=resultslist},
	affiliations = {Kg Reddy College of Engineering and Technology, Department of Data Science, Moinabad, Hyderabad, India; Sairam Engineering College, Department of Cybersecurity, Tamil Nadu, Chennai, India; Kg Reddy College of Engineering and Technology, Department of Cse, Moinabad, Hyderabad, India; Department of CSE-DS, Griet, Bachupally, Hyderabad, India},
