	title = {Design of an Integrated Model for Explainable Preemptive and Adaptive Financial Fraud Detection for Real Time Scenarios},
	year = {2025},
	journal = {2025 IEEE 7th International Conference on Cybernetics, Cognition and Machine Learning Applications, ICCCMLA 2025},
	pages = {},
	doi = {10.1109/ICCCMLA66092.2025.11580456},
	url = {https://www.scopus.com/pages/publications/105044690913?origin=resultslist},
	affiliations = {Sr University, School of Computer Science and Artificial Intelligence, Telangana, Warangal, India; Amity University, Department of Cse, Punjab, India},
	abstract = {Financial fraud evolves at a pace that outstrips most conventional detection frameworks. Banks and payment networks continue to rely on models retrained in rigid cycles and explained only after deployment, leaving them vulnerable to sudden, small-sample fraud bursts and explanations that feel disconnected from the underlying decision logic. This limitation motivated the development of an adaptive, explainable pipeline designed for real-time use. Traditional systems treat representation learning, detection, and validation as separate tasks, and they rarely test whether explanations remain stable when fraud strategies shift. The proposed architecture integrates these components through five interdependent methods. Drift-aware Contrastive Embedding reshapes transaction embeddings using temporal drift signals, allowing fraud behaviors to be separated without heavy manual feature engineering. These embeddings flow into an Intrinsic Explainable Neural Tree , a self-describing decision model whose splitting rules align with Drift-aware Contrastive Embedding's attention. Meta-Adaptation by Few-Shot Fraud Transfer then tunes the tree with just a handful of labeled cases, enabling detection of new fraud schemes within hours. Adversarial and Counterfactual Explainability Stress Testing applies realistic perturbations to quantify how little input change can alter decisions or their rationales. Finally, a Continuous Feedback and Audit Loop integrates analyst input and explanation-stability metrics back into the pipeline, ensuring continuous adaptation. Large-scale transaction experiments yield an AUC of 0.97 and nearly 20% fewer drift-related false positives than periodic retraining sets. Explanations remain consistent in about 90% of perturbed cases. These findings suggest adaptability and transparency can co-exist, though tension between responsiveness and stability remains unresolved in process.  © 2025 IEEE.},
	author_keywords = {Adversarial Validation; Analysis; Concept Drift; Explainable AI; Few Shot Learning; Financial Fraud Detection},
	keywords = {Artificial intelligence; Crime; Embeddings; Forestry; Adversarial validation; Analyze; Concept drifts; Embeddings; Explainable AI; Few shot learning; Financial fraud; Financial fraud detections; Integrated modeling; Real- time; Finance},
	correspondence_address = {M. Madhusudhan; Sr University, School of Computer Science and Artificial Intelligence, Warangal, Telangana, India; email: 2303c50104@sru.edu.in},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833156162-8},
	language = {English},
	abbrev_source_title = {IEEE Int. Conf. Cybern., Cogn. Mach. Learn. Appl., ICCCMLA},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Gonzalez Casanova2026749,
	author = {Gonzalez Casanova, Lionel F.},
	title = {Leakage-Aware Hybrid Deep Learning Framework for Explainable Ethereum Fraud Detection},
	year = {2026},
	journal = {ICCE-TW 2026 - The 13th IEEE International Conference on Consumer Electronics - Taiwan: Sustainable and Human-centered AI in Consumer Electronics, Proceedings},
	pages = {749 - 750},
	doi = {10.1109/ICCE-TAIWAN71481.2026.11652576},
	url = {https://www.scopus.com/pages/publications/105049188272?origin=resultslist},
	affiliations = {National Taipei University, Sanxia, Taiwan},
	abstract = {Fraud detection in Ethereum transactions is challenging due to pseudonymous wallets, temporal dependencies, and the risk of data leakage during evaluation. This paper presents a leakage-aware hybrid framework that combines a Denoising Variational Autoencoder (DVAE) for latent feature extraction, a BiLSTM for sequential modeling, and XGBoost for interpretable classification. The model is evaluated on the Ethereum Kaggle dataset using two protocols: Wallet-Level Split (WLS) and Time-Aware Wallet-Level Split (TA-WLS). Results averaged over three runs show stable and strong performance. Under WLS, the model achieves a macro-F1 score of 0.9400 and a ROC-AUC of 0.9840. Under the more realistic TA-WLS protocol, performance improves to a macro-F1 of 0.9720 and a ROC-AUC of 0.9931, indicating robust temporal generalization and reduced evaluation bias. SHAP-based analysis identifies ERC20 transaction magnitude, contract interactions, and temporal activity patterns as the most influential factors driving predictions. These results demonstrate that integrating latent representation learning, temporal modeling, and explainability provides a reliable and deployable solution for Ethereum fraud detection. © 2026 IEEE.},
	author_keywords = {BiLSTM; Denoising Autoencoder; Ethereum; Explainable AI; Fraud Detection; SHAP; Temporal Modeling; Time-Aware Split; Wallet-Level Split; XGBoost},
	keywords = {Crime; Deep learning; Error detection; Information leakage; Learning systems; Auto encoders; BiLSTM; De-noising; Denoising autoencoder; Explainable AI; Fraud detection; SHAP; Temporal models; Time-aware split; Wallet-level split; Xgboost; Ethereum},
	correspondence_address = {L.F. Gonzalez Casanova; National Taipei University, Sanxia, Taiwan; email: gonzalez74@gm.ntpu.edu.tw},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-831950642-9},
	language = {English},
	abbrev_source_title = {ICCE-TW - IEEE Int. Conf. Consum. Electr. - Taiwan: Sustain. Hum.-centered AI Consum. Electr., Proc.},
	type = {Conference paper},
	publication_stage = {Final},
