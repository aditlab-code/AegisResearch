	abstract = {Local Interpretable Model-agnostic Explanations (LIME) has emerged as a widely adopted technique for interpreting black-box machine learning models. In high-stakes application domains such as healthcare and finance, decisions directly affect safety, fairness, and compliance, making post-hoc interpretability a must-have rather than a nice-to-have. However, its efficacy on tabular data is frequently compromised by inadequate sampling in the synthetic neighborhood, particularly in scenarios involving high-dimensional feature spaces or imbalanced data distributions. This paper introduces TLIME, an enhanced framework that incorporates feature-aware stratified sampling into the LIME methodology. By systematically partitioning the feature space and ensuring proportional representation across all strata, TLIME yields more stable and accurate explanations. Across four tabular datasets—Higgs Boson, Census Income, House Prices, and Credit Card Fraud Detection—TLIME, on average, improves local fidelity (R<sup>2</sup>) by 107.3%, increases range coverage (RC(Y)) by 20.0%, and raises the coefficient of variation (CV(β)) by 67.0% over standard LIME (Gaussian sampling). These gains mean that the local surrogate more faithfully matches the black-box (higher R<sup>2</sup>), the synthetic neighborhood better spans the model’s output space (higher RC(Y)), and the attributions more clearly differentiate important from unimportant features (higher CV(β)), thereby supporting model auditing, risk management, and regulatory reporting in clinical decision support and credit scoring. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	author_keywords = {Explainable AI (XAI); LIME; Model-agnostic; Stability},
	keywords = {Artificial intelligence; Convergence of numerical methods; Decision making; Decision support systems; Learning systems; Population statistics; Risk assessment; Risk management; Applications domains; Black boxes; Explainable AI (XAI); High-dimensional feature space; Interpretability; Local interpretable model-agnostic explanation; Machine learning models; Model-agnostic; Neighbourhood; Tabular data; Lime},
	correspondence_address = {X. Li; School of Computer Science and Engineering, Nanjing University of Science and Technology, Nanjing, China; email: lixs@njust.edu.cn},
