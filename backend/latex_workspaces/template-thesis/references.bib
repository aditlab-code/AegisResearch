	keywords = {Big data; Crime; Digital storage; Hardware security; Hash functions; Learning algorithms; Learning systems; Machine learning; Block-chain; Credit card fraud detections; Credit card frauds; Credit cards; Explainable AI; Machine-learning; Payment systems; Secure modeling; SHA-512 cryptography; Transaction security; Ethereum},
