@CONFERENCE{Wakude2026,
	author = {Wakude, Sudhir and Deshpande, Uttam U. and Allagi, Shridhar},
	title = {Towards Trustworthy Financial Fraud Detection: A Systematic Review and Unified Taxonomy of Causal Inference, Explainable AI, and Robust Machine Learning},
	year = {2026},
	journal = {2026 6th International Conference on Intelligent Technologies, CONIT 2026},
	pages = {},
	doi = {10.1109/CONIT69683.2026.11621614},
	url = {https://www.scopus.com/pages/publications/105047337343?origin=resultslist},
	affiliations = {Visvesvaraya Technological University, Kls Gogte Institute of Technology, Department of Computer Science and Engineering, Karnataka, Belagavi, India; Jain College of Engineering (JCE), Department of Computer Science and Engineering, Karnataka, Belagavi, India; Kle Institute of Technology, Department of Computer Science and Engineering, Karnataka, Hubballi, India},
	abstract = {One of the largest concerns of the modern digital payment systems has become financial frauds, and more than 40 billion dollars are lost in the world every year. Although machine learning models have increased the level of accuracy in detecting fraud, it still has some limitations. Most of the existing systems rely on correlation-based predictions being vulnerable to the shift in distribution, low interpretation to regulatory au- diting within systems such as the GDPR and EU AI Act, and vulnerable to adversarial manipulation.This survey describes three directions that are complementary to each other through the review of recent papers that have attempted to provide solutions to these shortcomings. First, Structural Causal Models/ Structural Causal Models (SCMs) and do-calculus provide methods of answering them using causal inferences in an intervening form, in that is, in a P(Y | do(X)) form, which systems can reason causal efficientially and not just cause-effect correlates. Second, interpretable artificial intelligence tools such as SHAP and LIME will lead to the attainment of the attribution scores φ<sub>i</sub> of the features that lead to the improved model transparency and auditability. Third, adversarial training and invariant risk minimization (IRM) are machine learning methods that are robust in nature to achieve good solidarity to models when perturbed with adversarial instances and distribution distortions. The survey is obtained after the analysis of 82 peer-reviewed papers, which generates one taxonomy that represents the combination of causal inferences, explainable artificial intelligence, and robust learning techniques to identify fraud in the finances. Literature reported literature performance, indicates that hybrid systems can achieve of up to 0.998 AUC values on literature test data sets such as IEEE-CIS as well as the European credit card dataset. Even though these encouraging results are obtained, there are several unclear aspects that need to be tackled like inability to scale up and availability of some hidden confounders. The questionnaire concludes with a discourse with some of the emerging research directions, such as causal transformers and federated explainable AI in favour of financial systems on a large scale. © 2026 IEEE.},
	author_keywords = {adversarial robustness; causal inference; explainable artificial intelligence; Financial fraud; LIME; robust machine learning; SHAP; structural causal models; trustworthy AI},
