	title = {Explainable Credit Card Fraud Detection via Imbalance Mitigation and LightGBM with SHAP Attribution},
	year = {2026},
	journal = {2026 2nd International Conference on Big Data and Machine Learning, ICBDML 2026},
	pages = {},
	doi = {10.1109/ICBDML68582.2026.11544514},
	url = {https://www.scopus.com/pages/publications/105042497785?origin=resultslist},
	affiliations = {StackNexus Inc., Ellicott City, MD, United States; Deloitte Consulting Llp, Raleigh, NC, United States; United States; Tata Consultancy Services Ltd., United States; Chandigarh University, Punjab, Mohali, 140413, India; Cgc University, School of Advance Computing, Punjab, Mohali, 140307, India},
	abstract = {The problem of detecting credit card fraud continues to be an issue in financial security (due to the large number of fraud transactions compared to the total number of transactions) with fraud transactions making up less than 0.2% of all total transactions. In this paper, we propose a Machine Learning Framework where methods of addressing the class imbalance and methods of classification are evaluated using real world data from credit card transactions. We compare SMOTE oversampling, random under sampling and class weighting techniques across five different models (Logistic Regression, Random Forest, XGBoost, LightGBM and Isolation Forest). Using experiments on 284,807 transactions with a fraud prevalence of.000172, our results indicate that LightGBM trained on SMOTE-balanced data performs the best with a Precision-Recall AUC of 85.7%, a fraud detection rate of 87.8% and a false positive rate of 0.37%. Our SHAP-based analysis increases model interpretability by determining PCA components V14, V17, V12, and V10 as the strongest predictors of fraud. By optimizing the decision threshold using the F2-score we increase the detection performance to 88.0% by aligning predictions with cost sensitive business objectives. Ultimately, the proposed framework provides a balanced, production ready fraud detection solution that addresses issues of performance, interpretability and operational trade-offs.  © 2026 IEEE.},
