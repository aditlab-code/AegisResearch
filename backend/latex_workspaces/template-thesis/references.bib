@CONFERENCE{Jayasekara2026,
	author = {Jayasekara, J.M.L.U. and Jayathissa, P.G.A.I. and Chandrapriya, W.A.A.S. and Vidanage, B.V.K.I.},
	title = {Inclusive Multimodal Fraud Detection for Differently Abled Users in Digital Banking},
	year = {2026},
	journal = {Proceedings - IEEE International Research Conference on Smart Computing and Systems Engineering, SCSE 2026},
	pages = {},
	doi = {10.1109/SCSE70081.2026.11499853},
	url = {https://www.scopus.com/pages/publications/105040706597?origin=resultslist},
	affiliations = {General Sir John Kotelawala Defence University, Department of Information Technology, Ratmalana, Sri Lanka; General Sir John Kotelawala Defence University, Department of Computer Science, Ratmalana, Sri Lanka},
	abstract = {AI-driven fraud detection systems in digital banking commonly assume uniform user behavior, often overlooking accessibility-driven interaction patterns, thereby disadvantaging differently abled users, senior citizens, and other vulnerable populations. This study proposes an Inclusive Multimodal Fraud Detection (IMFD) framework that integrates accessibility-aware signals, including voice biometrics, screen reader navigation behavior, haptic interaction patterns, and eye-tracking data, into a hybrid CNN-LSTM architecture with attention-based multimodal fusion. The framework was evaluated using a mixed-methods approach that combined simulated banking environments, public fraud datasets, and controlled user trials involving differently abled participants. Experimental results demonstrate that the proposed model achieves an overall accuracy of 96% under cross-validated settings, while significantly reducing false-positive fraud alerts for vulnerable user groups and maintaining a low-latency real-time performance. Embedded explainability, implemented through attention mechanisms and SHAP-based feature attribution, provides transparent and interpretable fraud decisions, supporting regulatory alignment with accessibility and data-protection standards. By explicitly modeling assistive interaction behaviors rather than treating them as anomalies, this study demonstrates how inclusive and explainable AI can enable secure, equitable, and scalable fraud detection in digital banking systems. © 2026 IEEE.},
	author_keywords = {accessibility signals; digital banking differently-abled users; explainable AI; financial inclusion; fraud detection; Multimodal AI},
	keywords = {Artificial intelligence; Association reactions; Banking; Behavioral research; Crime; Haptic interfaces; Information use; Interactive computer systems; Pattern recognition; Accessibility signal; Digital banking differently-abled user; Explainable AI; Financial inclusions; Fraud detection; Fraud detection system; Interaction pattern; Multi-modal; Multimodal AI; User behaviors; Eye tracking},
