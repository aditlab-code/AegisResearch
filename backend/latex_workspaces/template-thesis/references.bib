@CONFERENCE{Salim2026177,
	author = {Salim, Richard and Kusnadi, Thierry Jovan and Wiputra, Richard},
	title = {Comparative Analysis of Explainable Artificial Intelligence (XAI) for the Interpretability of Random Forest Models in Credit Card Fraud Detection},
	year = {2026},
	journal = {Proceedings of 3rd International Conference on Machine Learning and Autonomous Systems, ICMLAS 2026},
	pages = {177 - 183},
	doi = {10.1109/ICMLAS67792.2026.11483677},
	url = {https://www.scopus.com/pages/publications/105038757436?origin=resultslist},
	affiliations = {School of Information Systems, Bina Nusantara University, Information Systems Department, Jakarta, 11480, Indonesia},
	abstract = {The critical need for transparency in financial machine learning has made Explainable AI (XAI) essential for credit card fraud detection systems. While Random Forest (RF) models are widely adopted for their high accuracy in this domain, their interpretability remains challenging. This study provides a thorough comparison of three widely used XAI methods, SHAP, LIME, and Counterfactual Explanations (using DiCE) for interpreting RF predictions on a highly imbalanced credit card fraud dataset. We evaluate these methods along multiple dimensions: faithfulness to the RF model (fidelity), comprehensibility to end-users, and computational efficiency. Our experiments on the European cardholder's dataset demonstrate that SHAP provides theoretically grounded, high-fidelity explanations but with technical complexity; LIME offers intuitive local explanations at the cost of stability; while DiCE generates actionable 'what-if' scenarios that are most accessible to non-experts. The results show that none of the methods is universally better in every situation; instead, each one aligns with different stakeholder needs: SHAP supports regulatory requirements, LIME assists analyst investigations, and DiCE helps with customer-facing explanations. As a result, this study provides a practical framework to help financial institutions choose and apply XAI methods that fit their specific context, ensuring a good balance between technical reliability and real-world usefulness in their fraud detection systems. © 2026 IEEE.},
	author_keywords = {Counterfactual Explanations; Fraud Detection; Interpretable Machine Learning; LIME; Random Forest; SHAP; XAI},
	keywords = {Big data; Crime; Error detection; Information systems; Learning systems; Machine learning; Random forests; Counterfactual explanation; Counterfactuals; Fraud detection; Interpretability; Interpretable machine learning; Machine-learning; Random forest modeling; Random forests; SHAP; XAI; Computational efficiency},
