	title = {LLM-Augmented Explainable Ensemble Framework for Intelligent Financial Fraud Detection},
	year = {2026},
	journal = {6th International Conference on Computer Networks and Inventive Communication Technologies, ICCNCT 2026 - Proceedings},
	pages = {941 - 946},
	doi = {10.1109/ICCNCT68477.2026.11589966},
	url = {https://www.scopus.com/pages/publications/105045566888?origin=resultslist},
	affiliations = {Graphic Era Hill University, Dept. Of Computer Application, Dehradun, India; Graphic Era Hill University, Dept. Of Computer Science & Engineering, Dehradun, India; Graphic Era Deemed To Be University, Dept. Of Computer Application, Dehradun, India},
	abstract = {Given the gravity of its economic ramifications and as digital financial products have emerged to be today's banking solutions, fraud detection models require stratospheric levels of predictive accuracies coupled with highly interpretable model decisions supported by legislation. To this end, we introduce a novel LLM-Augmented Explainable Ensemble Framework to detect financial fraud in classes with imbalance of transactions. The new contribution of this work is in integrating cost-sensitive stacked ensemble learning, intrinsic SHAP-based explainability and LLM-driven semantic reasoning into a unified optimization framework. More precisely, an Explainability embedded Adaptive Probabilistic (E<sup>2</sup>AP) fusion process is proposed for merging heterogonous base learners resulting into both parallel feature attribution and consistence checking of explanations. In addition, quantitative feature contributions are re-arranged to structured prompts for LLM-inspired contextual rationale given human interpretable and audit-friendly decision support. This framework jointly co-optimizes the prediction performance and the explanation fidelity, addressing a critical gap between existing systems with respect to accuracy or interpretable performance. In experiments on a real-world financial transaction dataset, the new model achieves 96.1% accuracy, 95.1% in F1-score and AUC=0.98 outperforming classical ensemble methods as well as further improving fraud recall (5-13%). We introduce a scalable and reliable platform for establishing explainable yet high performing AI in financial risk management with this study. © 2026 IEEE.},
	author_keywords = {Ensemble Learning; Explainable Artificial Intelligence; Financial Fraud Detection; Imbalanced Classification; Large Language Models; Trustworthy AI},
