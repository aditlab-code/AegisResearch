@CONFERENCE{Jahan20252944,
	author = {Jahan, Sigma and Shah, Mehil B. and Mahbub, Parvez and Rahman, Mohammad Masudur},
	title = {Improved Detection and Diagnosis of Faults in Deep Neural Networks Using Hierarchical and Explainable Classification},
	year = {2025},
	journal = {Proceedings - International Conference on Software Engineering},
	pages = {2944 - 2956},
	doi = {10.1109/ICSE55347.2025.00224},
	url = {https://www.scopus.com/pages/publications/105010329991?origin=resultslist},
	affiliations = {Dalhousie University, Canada},
	abstract = {Deep Neural Networks (DNN) have found numerous applications in various domains, including fraud detection, medical diagnosis, facial recognition, and autonomous driving. However, D NN - based systems often suffer from reliability issues due to their inherent complexity and the stochastic nature of their underlying models. Unfortunately, existing techniques to detect faults in DNN programs are either limited by the types of faults (e.g., hyperparameter or layer) they support or the kind of information (e.g., dynamic or static) they use. As a result, they might fall short of comprehensively detecting and diagnosing the faults. In this paper, we present DEFault (Detect and Explain Fault) - a novel technique to detect and diagnose faults in DNN programs. It first captures dynamic (i.e., runtime) features during model training and leverages a hierarchical classification approach to detect all major fault categories from the literature. Then, it captures static features (e.g., layer types) from DNN programs and leverages explainable AI methods (e.g., SHAP) to narrow down the root cause of the fault. We train and evaluate DEFault on a large, diverse dataset of ≈ 14.5K DNN programs and further validate our technique using a benchmark dataset of 52 real-life faulty DNN programs. Our approach achieves≈ 94% recall in detecting real-world faulty DNN programs and ≈ 63% recall in diagnosing the root causes of the faults, demonstrating 3.92%-11.54% higher performance than that of state-of-the-art techniques. Thus, DEFault has the potential to significantly improve the reliability of DNN programs by effectively detecting and diagnosing the faults.  © 2025 IEEE.},
	author_keywords = {Deep Neural Networks; Dynamic Analysis; Model fault; Static Analysis; Training fault},
	keywords = {Artificial intelligence; Classification (of information); Diagnosis; Fault detection; Large datasets; Static analysis; Stochastic models; Stochastic systems; Autonomous driving; Detection and diagnosis; Dynamics analysis; Facial recognition; Fraud detection; Inherent complexity; Model fault; Neural-networks; Root cause; Training fault; Dynamic analysis},
