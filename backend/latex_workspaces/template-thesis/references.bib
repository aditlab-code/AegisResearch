	year = {2025},
	journal = {Proceedings of the 2025 3rd International Conference on Advances in Computation, Communication and Information Technology, ICAICCIT 2025},
	pages = {15 - 20},
	doi = {10.1109/ICAICCIT68829.2025.11433969},
	url = {https://www.scopus.com/pages/publications/105036152607?origin=resultslist},
	affiliations = {CEC, Chandigarh Group of Colleges, Dept. of Computer Science and Engineering, Mohali, India; CGC University, Dept of Applied Sciences, Mohali, India; Indira Gandhi University, Dept of CSE, Meerpur, India; CEC, Chandigarh Group of Colleges, Dept. of Computer Science and Engineering, India},
	abstract = {Deepfakes-synthetic images, audio, and video created or manipulated by generative models-have progressed from academic curiosities to tools of large-scale fraud and disinformation. Robust, generalizable, and efficient detection systems are required to safeguard digital integrity. This paper provides a comprehensive, 15-page comparative analysis of state-of-the-art deepfake detectors published between 2018 and mid-2025. We review 70+ works through an extensive literature survey, unify disparate benchmarks, and classify detectors into spatial CNNs, vision transformers, frequency-domain models, temporal networks, audio and multimodal systems, watermark-assisted and proactive methods, and adversarial robust variants. Cross-dataset experiments reveal that purely spatial CNN baselines suffer up to 40 percentage-point (pp) AUC drops, whereas hybrid transformers narrow the gap below 10 pp. We analyze adversarial robustness, fairness, edge deployment, and explainability, highlighting emerging trends such as self-supervised ViTs, identity-linked dynamic watermarks, and vision-language models for semantic forgery cues. A comprehensive state-of-the-art model's table summarizes 20 leading approaches with performance metrics across multiple datasets. The paper concludes with open challenges and research directions, arguing for standardized continual-learning benchmarks and human centered, explainable detectors. © 2025 IEEE.},
	author_keywords = {adversarial robustness; audio deepfake; Deepfake detection; explainable AI; multimodal fusion; vision transformer; watermarking},
