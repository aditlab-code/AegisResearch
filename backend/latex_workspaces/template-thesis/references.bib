	title = {X-Shield: Explainable Credit Card Fraud Detection Using XGBoost and SHAP for Analyst-Centric Triage},
	year = {2025},
	journal = {2025 IEEE 15th International Conference on System Engineering and Technology, ICSET 2025, Conference Proceedings},
	pages = {469 - 474},
	doi = {10.1109/ICSET65917.2025.11284062},
	url = {https://www.scopus.com/pages/publications/105032057948?origin=resultslist},
	affiliations = {Universiti Teknologi MARA, Faculty of Computer and Mathematical Sciences, Selangor, Shah Alam, 40450, Malaysia; Universiti Teknologi MARA, Faculty of Computer and Mathematical Sciences, Selangor, Shah Alam, 40450, Malaysia; Centre of Foundation Studies, Universiti Teknologi MARA, Selangor, 43800, Malaysia},
	abstract = {Credit card fraud remains a high-impact, low prevalence problem in financial infrastructures, and detection models that compromise high recall for strong analyst confidence are required. This paper introduces X-SHIELD, an explainable credit card fraud detection system that aligns the prediction capacity of XGBoost and the explainability of SHAP within an analyst-focused triage dashboard. Using a large-scale anonymized dataset of over 550,000 transactions, X-SHIELD is comprehensively tested under stratified hold-out, crossvalidation, and threshold-tuned regimes and displays nearperfect performance (accuracy of 99.97%, precision of 99.94%, and recall of 99.0%). Beyond raw performance, the system delivers case-level SHAP explanations that report feature contributions and build calibrated narratives, therefore filling the gap between algorithm-driven detection and human decision-making. Comparative analysis demonstrates that XSHIELD supersedes conventional baseline not only in prediction capacity but also in explainability, facilitating faster triage, improved analysts confidence, and superior regulatory compliance. By aligning the best-of-class classification through transparent interpretability, X-SHIELD represents a significant step toward reliable and operationally tenable AI-driven fraud detection. © 2025 IEEE.},
