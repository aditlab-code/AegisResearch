	pages = {},
	doi = {10.1109/ICMCTC62214.2025.11196104},
	url = {https://www.scopus.com/pages/publications/105022276094?origin=resultslist},
	affiliations = {CMR Institute of Technology, Department of Computer Science and Engineering, Hyderabad, India; Sethu Institute of Technology, Department of Mechanical Engineering, Tamil Nadu, Pulloor, Kariapatti, 626115, India; Gokaraju Rangaraju Institute of Engineering and Technology, Department of CSE, Telangana, Hyderabad, India; The Islamic University, College of Technical Engineering, Department of Computers Techniques Engineering, Iraq, Al Diwaniyah, Najaf, Iraq; Department of CSE, CMR Technical Campus, Telangana, Hyderabad, India; Mohan Babu University, Department of Mechanical Engineering, Andhra Pradesh, Tirupati, India},
	abstract = {The sophistication of financial fraud has grown due to the continuous advancements in detecting financial fraud, which requires advanced detection mechanisms that are capable of real-time adaptation. Evolutionary fraud patterns pose challenges to rule-based and machine learning models such that these have high false positive rates and low detection rates. The proposed financial fraud detection system in this paper is composed of an autonomously trained Automated Graph Neural Network (AGNN) to learn the behavior of the fraudulent user in real time without the help of static training datasets. Behind our approach, we construct a heterogeneous transaction graph enabled with multi-modal (user behavior, transaction metadata, device intelligence) data sources. To avoid relying on a lot of labeled data for anomaly detection in evolving transaction networks, the proposed Self-Learning Graph Neural Network (SL-GNN) employs self-supervised contrastive learning to detect anomalies. Furthermore, meta learning and reinforcement learning based on the Autonomous Fraud Pattern Evolution Engine (AFPE) always updates the fraud detection parameters to form more adaptive content to new and swift threats. To enable privacy-preserving cross-institution fraud intelligence sharing, the system utilizes federated learning and an Explainable AI (XAI) module is added for regulatory compliance and interpretability as well. Real financial datasets were evaluated by experiment, showing superior detection accuracy, fewer false alarms, and remarkably better real-time inference speed than existing traditional methods. The work presented in this research is an entirely novel adaptive, privacy preserving, and explainable fraud detection framework that could change the way finances are secure and risk managed. © 2025 IEEE.},
	author_keywords = {Autonomous Fraud Pattern Evolution Engine; Explainable AI; Graph Neural Network; Self-Learning Graph Neural Network},
