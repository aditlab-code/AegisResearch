@CONFERENCE{Hu20262292,
	author = {Hu, Yuchen and Yuan, Yi},
	title = {E-Commerce Data Security at Scale: Ensemble Learning with SHAP-Driven Explainability for Real-Time Fraud Transaction Detection},
	year = {2026},
	journal = {Proceedings of 2026 7th International Conference on Computer Information and Big Data Applications, CIBDA 2026},
	pages = {2292 - 2296},
	doi = {10.1145/3813822.3814187},
	url = {https://www.scopus.com/pages/publications/105050167676?origin=resultslist},
	affiliations = {School of Economics and Management, Shanghai University of Political Science and Law, Shanghai, China},
	abstract = {The rapid growth of online retail has made e-commerce platforms prime targets for financial fraud, posing severe threats to data security and consumer trust. Existing fraud detection approaches suffer from three persistent limitations: (1) raw transactional features inadequately capture behavioural risk signals such as temporal anomalies and account credibility, (2) single-model classifiers exhibit high variance under the severely imbalanced class distribution typical of real-world fraud datasets (ρ ≈ 5%), and (3) black-box predictions lack the interpretability required for regulatory compliance and actionable forensic investigation. To address these challenges, we propose ESEF (Ensemble-SHAP E-commerce Fraud detection), a unified framework that integrates risk-aware feature engineering with multi-model ensemble learning and SHAP-based explainability. Specifically, ESEF introduces (1) a temporal risk score and an account credibility weight to enrich the feature space with domain-grounded priors, (2) a comparative ensemble of six tree-based classifiers evaluated under 5-fold stratified cross-validation with 95% confidence intervals, and (3) a full-suite SHAP analysis - beeswarm, waterfall, force, heatmap, and dependence plots - to provide both global and instance-level fraud explanations. Experiments on a large-scale synthetic e-commerce dataset (N > 1.4 million transactions) demonstrate that the proposed framework achieves a training AUC of up to 0.980 and consistently interpretable feature attributions across all classifiers, validating its effectiveness for e-commerce data security applications. © 2026 Copyright held by the owner/author(s).},
	author_keywords = {anomaly detection; e-commerce data security; ensemble learning; explainable AI; fraud detection; imbalanced classification; SHAP analysis},
	keywords = {Behavioral research; Classification (of information); Crime; Digital forensics; Electronic commerce; Feature extraction; Forensic engineering; Large datasets; Learning systems; Risk assessment; Security of data; Anomaly detection; E- commerces; E-commerce data security; Ensemble learning; Explainable AI; Fraud detection; Imbalanced classification; Rapid growth; Real- time; SHAP analyze; Anomaly detection; Regulatory compliance},
