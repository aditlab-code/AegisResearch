@CONFERENCE{Ghag2026,
	author = {Ghag, Tanuj Surendra and Pachghare, Vinod K. and Patil, Charulata J.},
	title = {Critical Analysis of Explainable AI Deficiencies and Proposal for a Causal and Adaptive Grounded Framework},
	year = {2026},
	journal = {2026 International Conference on Next Generation Electronics, NELEX 2026},
	pages = {},
	doi = {10.1109/NELeX69209.2026.11590055},
	url = {https://www.scopus.com/pages/publications/105045588116?origin=resultslist},
	affiliations = {COEP Technological University, Department of Computer Science and Engineering, Pune, India},
	abstract = {Explainable Artificial Intelligence (XAI) systems are vital for reliable use in critical applications, such as fraud detection or medicine; however, popular XAI techniques like LIME and SHAP are prone to generating unreliable and causally erroneous explanations. We present in this paper ACXAI, a causality-oriented supervisory approach for XAI, combining structural causal models (SCM), stability filtering, and context-specific rules for explanation generation. We analyze the limitations of current XAI techniques along four dimensions: stability, causality, user-centricity, and deployability through formal definitions. Our empirical findings on a practical credit card fraud detection data set show that ACXAI increases the stability of the explanations (Jaccard coefficient) by up to 49%, while achieving better causal consistency and without any loss in predictive accuracy compared to state-of-the-art techniques. Experimental evidence collected in healthcare and image analysis domains confirms these gains. The main contributions of our work are threefold: (1) the systematic evaluation of XAI limitations, (2) the introduction of an adaptive XAI approach based on SCM and (3) a cross-domain assessment of the proposed framework demonstrating significant improvements in terms of explanation stability and usefulness.  © 2026 IEEE.},
	author_keywords = {Adaptive XAI; Causal Inference; Explainable AI; Rule-based Explanations; Stability Metrics},
	keywords = {Artificial intelligence; Crime; Stability; Adaptive XAI; Causal inferences; Causal modeling; Critical analysis; Critical applications; Explainable AI; Fraud detection; Rule based; Rule-based explanation; Stability metrics; Convergence of numerical methods},
