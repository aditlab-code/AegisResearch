	title = {VishGuard: AI-Powered Real-Time Defense Against Voice Phishing},
	year = {2025},
	journal = {2025 IEEE 5th International Conference on ICT in Business Industry and Government, ICTBIG 2025},
	pages = {},
	doi = {10.1109/ICTBIG68706.2025.11323735},
