	title = {Data Analytics in Banking: Improving Financial Monitoring and Risk Control},
	year = {2026},
	journal = {2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications, ICCSDFAI 2026},
	pages = {656 - 661},
