	title = {A Comparative Review of Fraud Detection Techniques Using the IEEE-CIS Dataset},
	year = {2026},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1725 LNNS},
	pages = {207 - 223},
	doi = {10.1007/978-3-032-10940-8_17},
	url = {https://www.scopus.com/pages/publications/105028365298?origin=resultslist},
	affiliations = {Department of Computer Science and Engineering, Maulana Azad National Institute of Technology, Bhopal, India; Centre for Artificial Intelligence, Maulana Azad National Institute of Technology, Bhopal, India},
	abstract = {Credit card fraud detection remains a pressing challenge due to the rarity and complexity of fraudulent transactions. This paper presents a comparative review of twelve peer-reviewed studies that utilize the IEEE-CIS Fraud Detection dataset, a high-dimensional and imbalanced real-world benchmark. The reviewed methods span traditional machine learning, ensemble techniques, deep learning architectures, hybrid models, and privacy-preserving frameworks. Performance metrics such as AUC and F1-score are analyzed, with reported AUC values ranging from 0.88 to 0.9999. Key methodological trends include the dominance of ensemble methods, the emergence of unsupervised anomaly detection, and growing interest in federated learning. Despite high performance, issues like overfitting, lack of interpretability, and reproducibility persist. The paper concludes by identifying critical research gaps and proposing future directions in explainable AI, temporal modeling, and privacy-aware learning. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	author_keywords = {Deep Learning; Ensemble Learning; Feature Engineering; Fraud Detection; IEEE-CIS Dataset; Imbalanced Data Handling; Machine Learning},
	keywords = {Anomaly detection; Crime; Distributed computer systems; Learning systems; Privacy-preserving techniques; Credit card fraud detections; Deep learning; Ensemble learning; Feature engineerings; Fraud detection; IEEE-CIS dataset; Imbalanced data; Imbalanced data handling; Machine-learning; Pressung; Deep learning},
	correspondence_address = {R. Meena; Department of Computer Science and Engineering, Maulana Azad National Institute of Technology, Bhopal, India; email: ravi57meena@gmail.com},
	editor = {Nanda S.J. and Yadav R.P. and Prasad M. and Saraswat M.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
