@CONFERENCE{Safa2026,
	author = {Safa, Hajira and Vanshika and Saud, Taha and Kirmani, Syed Nakeeb Javaid and Ronihal, Shreedevi S},
	title = {A Secure Model for Detecting Credit Card Fraud Using Machine Learning and Blockchain},
	year = {2026},
	journal = {GSEACT 2026 - 2026 IEEE Global Symposium on Emerging and Communication Technologies},
	pages = {},
	doi = {10.1109/GSEACT68539.2026.11620436},
	url = {https://www.scopus.com/pages/publications/105047881465?origin=resultslist},
	affiliations = {Bnm Institute of Technology, Department of Information Science And Engineering, Bengaluru, India},
	abstract = {Credit card scams continue to pose a major problem in today's digital payment systems. This leads to serious financial losses and raises security concerns. While machine learning (ML) techniques have proven effective in detecting fraudulent transactions, many current methods rely on centralised data storage. This kind of storage is vulnerable to tampering and lacks long-term auditability. To overcome these obstacles, this paper presents a secure hybrid structure that blends machine learning-based fraud detection with cryptographic hashing and blockchain for permanent storage. In this system, transaction data gets analysed using supervised ML models to classify transactions as fraudulent or legitimate. The classification result, along with key transaction details, is protected using the SHA-512 cryptographic hash function, ensuring data integrity. The generated hash is then permanently saved on an Ethereum-based blockchain created using Ganache and smart contracts. It provides a permanent, verifiable history that anyone can audit. Instead of just getting a 'yes' or 'no' from an algorithm, we get a clear look at the 'why'- both for individual transactions and across the entire system. When we tested this on real-world European credit card data, the results were clear: it doesn't just catch fraud reliably; it builds trust. By layering machine learning with blockchain and cryptography. © 2026 IEEE.},
