}

@ARTICLE{Cao2026,
	author = {Cao, Jiajia},
	title = {Explainable Federated Learning Model for Cross-Institutional Digital Financial Data Collaboration and Risk Control},
	year = {2026},
	journal = {Journal of Visualized Experiments},
	volume = {2026-March},
	number = {229},
	pages = {},
