@CONFERENCE{Errahibi2025,
	author = {Errahibi, Hamza and Abbour, Fatima Zahra and Lghaouch, El Mehdi and Yman, Chemlal and Azzouazi, Mohamed},
	title = {Integrating Fraud Detection into Insurance Risk Prediction via Machine Learning},
	year = {2025},
	journal = {2025 4th International Conference on Embedded Systems and Artificial Intelligence, ESAI 2025},
	pages = {},
	doi = {10.1109/ESAI67033.2025.11438774},
	url = {https://www.scopus.com/pages/publications/105035989753?origin=resultslist},
	affiliations = {Faculty of Sciences Ben M'Sik, Hassan II University, Laboratory of information technology and Modeling, Casablanca, Morocco},
	abstract = {Insurance companies face a dual challenge of accurately assessing the level of risk associated with each of their clients. At the same time, they also need to have an ability to identify instances of fraudulent activity which could undermine any future claims made by these clients and potentially jeopardise their overall financial viability. As such, traditional actuarial and rule-based approaches typically separate the challenge of assessing risk (i.e., determining whether a client is likely to present a claim) from the challenge of detecting fraud; consequently, neither method generates equitable and reliable data upon which decisions regarding the disposition of a claim can be based, nor do either of them inherently prevent discrimination (or bias) in predicting client risk. This paper proposes a new and unique framework that incorporates machine learning (ML) model(s) to take into account both methodologies as part of the same analytic pipeline. This results in both augmented predictive accuracy of risk classifications as well as significantly enhanced interpretability of the ML models themselves. Specifically, the proposed framework utilises realtime datasets provided by a variety of insurers, then jointly models the client's risk and their fraud likelihood through a combination of ensemble learning, anomaly detection and explainable artificial intelligence (XAI) techniques. Experiments indicate that utilizing fraud features significantly enhances overall predictive accuracy (i.e., 9% improvement in risk and 18% higher recall rate for frauds) in comparison to existing ML methods. Ultimately, results produced by the proposed methodology illustrate that combining analysis of fraud with that of client risk increases the overall reliability of current insurance analytic models. Thus, offering increased transparency and neutrality for insurers' models is based on both their risk and fraud likelihoods. © 2025 IEEE.},
	author_keywords = {Ensemble Learning; Explainable AI; Fraud Detection; Insurance Risk Prediction; Machine Learning},
	keywords = {Analytical models; Anomaly detection; Crime; Forecasting; Insurance; Machine learning; Reliability analysis; Risk assessment; Risk perception; Ensemble learning; Explainable AI; Fraud detection; Insurance companies; Insurance risk; Insurance risk prediction; Machine learning models; Machine-learning; Predictive accuracy; Risk predictions; Learning systems},
	correspondence_address = {H. Errahibi; Faculty of Sciences Ben M'Sik, Hassan II University, Laboratory of information technology and Modeling, Casablanca, Morocco; email: hamza.errahibi-etu@etu.univh2c.ma},
