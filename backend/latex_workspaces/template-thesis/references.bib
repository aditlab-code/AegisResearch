	isbn = {979-833157457-4},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Mach. Learn. Auton. Syst., ICMLAS},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

