@CONFERENCE{Kapoor2026912,
	author = {Kapoor, Manav and Shrivastava, Apurva},
	title = {Beyond Static Thresholds: RAG-Enhanced Compliance for New-Account Fraud Detection in Payout Systems},
	year = {2026},
	journal = {Proceedings - 23rd International Joint Conference on Computer Science and Software Engineering, JCSSE 2026},
	pages = {912 - 917},
	doi = {10.1109/JCSSE68839.2026.11596786},
	url = {https://www.scopus.com/pages/publications/105045251167?origin=resultslist},
	affiliations = {United States},
	abstract = {New-account fraud in payout systems presents a unique detection challenge: adversaries exploit the absence of behavioral history to evade static rule-based controls. This paper introduces a Retrieval-Augmented Generation (RAG) framework that dynamically grounds fraud-scoring decisions in evolving regulatory guidance and threat intelligence, enabling context-aware, explainable compliance enforcement without requiring model retraining. Our system retrieves semantically relevant policy documents and risk signals at inference time, augmenting a gradient-boosted classifier with natural-language compliance context. Evaluated on a dataset of 284,807 transactions, the RAG-augmented model achieves an AUC of 0.9924 and a precision-recall AUC of 0.9847, compared to 0.9801 and 0.9743 for the baseline. Regulatory alignment improved from 0.79 to 0.94 under FinCEN and NACHA guidelines, with a statistically significant improvement (p < 0.001). The framework reduces manual review workload by 34% while maintaining a false-negative rate below 1.2% for high-risk accounts. We further detail a production deployment architecture supporting real-time inference at sub-100-millisecond latency with five-nines availability, and present an expanded analysis covering RAG component design choices, generalization considerations across financial institution environments, adversarial robustness, and failure modes. These results demonstrate that RAG-augmented fraud detection achieves superior accuracy, regulatory fidelity, and operational efficiency compared to static threshold models. © 2026 IEEE.},
	author_keywords = {explainable AI; FinCEN; fraud detection; gradient boosting; NACHA; new-account fraud; payout systems; regulatory compliance; retrieval-augmented generation},
	keywords = {Artificial intelligence; Behavioral research; Crime; Information systems; Information use; Explainable AI; FinCEN; Fraud detection; Gradient boosting; NACHA; New-account fraud; Payout system; Retrieval-augmented generation; Rule-based control; Static thresholds; Regulatory compliance},
