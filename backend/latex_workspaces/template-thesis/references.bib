	pages = {741 - 748},
	doi = {10.1109/ICCSDFAI70505.2026.11647954},
	url = {https://www.scopus.com/pages/publications/105049048623?origin=resultslist},
	affiliations = {K. Kulazhanov Kazakh University of Technology and Business, Kazakhstan; Astana It University, Astana, Kazakhstan; Astana International University, Higher School of Law, Astana, Kazakhstan; Narxoz University, Law Department, Almaty, Kazakhstan; Astana It University, School of Software Engineering, Astana, Kazakhstan},
	abstract = {Public procurement systems remain highly vulnerable to fraud, collusion, and supplier-oriented manipulation due to the scale and complexity of procurement ecosystems. Traditional Long-held audit procedures and rule-based monitoring methods often cannot identify hidden semantic irregularities, abnormal behavior, and complex supplier-to-supplier interaction patterns, especially in multilingual Public Procurement Systems. This study introduces an AI-based, multimodal anomaly detection framework for intelligent public procurement analysis in Kazakhstan called ProcureGuard-KZ. The multimodal framework combines structural procurement metrics, multilingual transformation-based text embeddings, graph-based supplier-to-supplier interaction analysis, and dynamic anomaly reasoning into a single explainable intelligence system. Each component of the system - Isolation Forest, XGBoost, multilingual/semantic modeling, and linguistic risk scoring generates dynamic procurement risk estimates and identifies procurement anomalies. Empirical evaluations indicate the effectiveness of the proposed multimodal anomaly detection framework in improving anomaly detection compared to traditional structural-only anomaly detection methods while providing additional robustness to fluctuating procurement conditions. The integration of cross-lingual semantic analysis and relational intelligence improves the identification of hidden patterns of manipulation and restricted features in the procurement process. Furthermore, explaining SHAP-based procurement risk decisions through the level of feature explanation will allow for increased transparency in auditing and compliance. Ultimately, the proposed framework demonstrates the capability of adaptive multimodal AI systems in providing intelligent monitoring of procurement in multi-lingual government systems. © 2026 IEEE.},
	author_keywords = {anomaly detection; explainable AI; graph analysis; multilingual NLP; procurement intelligence; public procurement; XGBoost},
