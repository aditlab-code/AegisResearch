@CONFERENCE{Kremper2026,
	author = {Kremper, Antonin Chevalier and Daher, Malak and Ziade, Abdellah and Chendeb, Nancy},
	title = {Toward Trustworthy Audit Automation: Explainable Meta-Learning for Financial Fraud Detection},
	year = {2026},
	journal = {2026 International Conference on Artificial Intelligence, Systems, and Emerging Technologies, ICAISET 2026},
	pages = {},
	doi = {10.1109/ICAISET66439.2026.11541703},
	url = {https://www.scopus.com/pages/publications/105042179656?origin=resultslist},
	affiliations = {De Vinci Higher Education, Courbevoie, 92400, France; Jinan University, Business Administration Dept, Beirut, Lebanon; Lebanese University, Zaca International, Beirut, Lebanon; De Vinci Research Center, De Vinci Higher Education, Courbevoie, 92400, France},
	abstract = {With the increasing volume of transactions and sophistication of fraud schemes, automation of financial auditing presents significant challenges, especially conditions surrounding the need for explainability required by the regulatory environment. While there are many advances in machine learning providing excellent opportunities for improving methods of anomaly detection, there are two primary reasons that limit their adoption in practice: (1) no universally applicable optimal detection algorithm and (2) no method implementing to achieve needed transparency in a regulated audit setting.In this paper, we propose a contextual and explainable meta-learning framework for financial anomaly detection. Our approach combines multiple supervised and unsupervised detectors, within a unified meta-model architecture. Transactional data are enriched with contextual features, and model outputs are aggregated through supervised meta-learners that adaptively weight each detector based on the transaction profile. To ensure transparency, we integrate multi-level explainability using feature importance analysis, SHAP, and LIME, providing both global and local interpretations of model decisions.Experiments conducted on realistic financial fraud datasets demonstrate that the proposed meta-model significantly outperforms individual detectors and traditional aggregation methods, achieving an improvement of approximately 50% in the F2-score. The results also highlight the dominant contribution of supervised models, whereas unsupervised methods provide limited complementary value in this setting.Overall, this study shows that combining contextual feature engineering, meta-learning, and explainable AI enables more accurate, robust, and trustworthy anomaly detection systems, paving the way for their effective integration into real-world audit processes. © 2026 IEEE.},
	author_keywords = {Explainable Artificial Intelligence (XAI); Financial Anomaly Detection; Financial Auditing; Fraud Detection; Meta-Learning},
	keywords = {Anomaly detection; Crime; Error detection; Feature extraction; Finance; Learning algorithms; Learning systems; Supervised learning; Unsupervised learning; Anomaly detection; Condition; Contextual feature; Explainable artificial intelligence (XAI); Financial Anomaly; Financial anomaly detection; Financial auditing; Financial fraud detections; Fraud detection; Metalearning; Transparency},
