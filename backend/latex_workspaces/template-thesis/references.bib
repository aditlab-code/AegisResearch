@CONFERENCE{Muthusenthil2026,
	author = {Muthusenthil, B. and Ragul, M. and Sathishkumar, B. and Raahuleshwar, A.},
	title = {FinDriftXplain: Unsupervised Drift Detection and Characterization in Deep Learning Embeddings for Financial Fraud Detection},
	year = {2026},
	journal = {Proceedings  - IEEE International Conference on Future and Advanced Computing Technologies, ICFACT 2026},
	pages = {},
	doi = {10.1109/ICFACT66887.2026.11518297},
	url = {https://www.scopus.com/pages/publications/105041614546?origin=resultslist},
	affiliations = {Dept. of Artificial Intelligence and Data Science, SRM Valliammai Engineering College, Chengalpattu, India},
	abstract = {Machine learning models for financial fraud detection degrade silently when transaction patterns shift due to evolving fraud tactics and consumer behaviour changes, a phenomenon known as concept drift. Existing unsupervised drift detectors either lack domain specificity for financial tabular data or provide opaque alerts without actionable explanations. This paper proposes FinDriftXplain, a theoretically grounded frame-work integrating (i) a dual autoencoder architecture with proven complementary sensitivity to mean-shift and tail-distribution drifts, (ii) a statistically decorrelated composite drift score combining Frechet distance, reconstruction error divergence, and density shifts, and (iii) a Shapley-based drift attribution mechanism with formal semantic mapping validated through analyst evaluation. Experiments on IEEE-CIS fraud data demonstrate 93.2% drift detection F1-score (p<0.01 vs. DriftLens) with 87.4% feature attribution accuracy. The framework enables targeted model adaptation, recovering fraud detection AUC from 0.82 to 0.94 post-drift while reducing retraining overhead by 62% compared to full model updates. © 2026 IEEE.},
	author_keywords = {Concept Drift; Deep Learning. Autoencoders; Explainable AI; Financial Fraud Detection; Shapley Values; Unsu pervised Learning},
	keywords = {Consumer behavior; Crime; Embeddings; Finance; Semantics; Unsupervised learning; Auto encoders; Concept drifts; Deep learning.; Embeddings; Explainable AI; Financial fraud detections; Machine learning models; Shapley value; Shift-and; Unsu pervised learning; Deep learning},
