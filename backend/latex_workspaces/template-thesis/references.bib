@CONFERENCE{Pai2026,
	author = {Pai, Deepak and Pappu, Karthik and Gangaiah, Yogeesh Kunigal},
	title = {Audit-Ready Fraud Detection: Aligning Gradient Boosting and SHAP with GDPR and SOX Compliance},
	year = {2026},
	journal = {2026 International Conference on Artificial Intelligence, Systems, and Emerging Technologies, ICAISET 2026},
	pages = {},
