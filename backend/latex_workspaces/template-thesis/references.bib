	affiliations = {Vivekananda Global University, Rajasthan, Jaipur, India; Srm University, Department of Law, Sonipat, India; Ims Unison University Dehradun, School of Law, India; Dayanand Women's Training College, Dehradun, India; Faculty of Physiotherapy Marwadi University, Department of Physiotherapy, India},
