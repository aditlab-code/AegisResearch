@ARTICLE{Dai20267012,
	author = {Dai, Li},
	title = {The Application of Machine Learning in Identifying Financial Fraud in Listed Companies},
	year = {2026},
	journal = {International Journal of Advanced Science and Engineering},
	volume = {13},
	number = {1},
	pages = {7012 - 7036},
	doi = {10.29294/IJASE.13.1.2026.7012-7036},
	url = {https://www.scopus.com/pages/publications/105053431164?origin=resultslist},
	affiliations = {School of Financial Management, Chengdu Gingko College of Hospitality Management, Sichuan, Chengdu, 611743, China},
	abstract = {Financial fraud in listed companies is a challenging problem for investors, regulators, and auditors because traditional auditing and traditional machine learning technologies cannot simultaneously capture complex relational dependence, temporal financial evolution, and nonlinear feature interactions. The current hybrid fraud detection models mainly rely on Graph Neural Networks (GNNs), Long Short-Term Memory (LSTM) networks, or late-stage integration of these networks, which leads to suboptimal cross-domain feature learning and a lack of interpretability. To bridge this gap, in this work, we propose a Hybrid Explainable Graph-Based Deep Learning (HEGDL) framework which provides a unified multi-view learning architecture with adaptive feature fusion to learn both relational information and temporal information from financial graphs, as well as structured information from financial data, while embedding SHAP-based explainability into the prediction process. The framework comprises of data preprocessing, graph construction, feature engineering, parallel GNN-LSTM-XGBoost learning, adaptive feature fusion and explainable fraud classification. The experimental results on a benchmark financial fraud dataset show that HEGDL achieves an accuracy of 97.2%, a precision of 96.5%, a recall of 95.8% and an F1-score of 96.1% which outperform the conventional machine learning models and recent hybrid approaches by 2-5% overall accuracy, and by being interpretable and supported by feature-level explanations for the regulatory decision-making process. The results are evidence of the effectiveness of the proposed framework in detecting financial fraud in listed companies, which is more accurate, interpretable, and reliable. © 2026 Mahendrapublications.com, All rights reserved.},
	author_keywords = {Data Analytics; Deep Learning; Engineering Applications; Explainable AI; Financial Fraud Detection; Graph Neural Network; LSTM; Machine Learning; SHAP; XGBoost},
