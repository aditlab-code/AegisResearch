@ARTICLE{Mohanakrishnan2026700,
	author = {Mohanakrishnan, Shankari Seethalakshmi},
	title = {Hybrid Fraud Detection Using Isolation Forest and Boosting Models with SHAP Explainability for IEEE-CIS Dataset},
	year = {2026},
	journal = {Journal of Wireless Mobile Networks, Ubiquitous Computing, and Dependable Applications},
	volume = {17},
